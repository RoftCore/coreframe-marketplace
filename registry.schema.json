{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Explotador72/coreframe-marketplace/raw/main/registry.schema.json",
  "title": "CoreFrame marketplace registry",
  "description": "The file CoreFrame fetches from its marketplace URL. CoreFrame itself only reads extensions[].id, .name, .version, .download_url and .versions[]; every other field is for the site and for humans, and extra fields are ignored by the app.",
  "type": "object",
  "required": ["$schema", "publisher", "extensions"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": { "type": "string" },
    "publisher": { "type": "string" },
    "repository": { "type": "string", "format": "uri" },
    "site": { "type": "string", "format": "uri" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "author", "description", "category", "download_url", "versions"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$",
            "description": "Must equal the id inside the extension's extension.json, or CoreFrame installs it under the wrong name."
          },
          "name": { "type": "string" },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
            "description": "Newest published version; must equal versions[0].version."
          },
          "author": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "icon": { "type": "string" },
          "platforms": { "type": "array", "items": { "type": "string", "enum": ["windows", "linux", "macos"] } },
          "grid_size": {
            "type": "object",
            "properties": { "w": { "type": "integer", "minimum": 1 }, "h": { "type": "integer", "minimum": 1 } }
          },
          "download_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://.*\\.zip$",
            "description": "Must equal versions[0].download_url: older CoreFrame builds read only this pair."
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "description": "Newest first. CoreFrame shows a dropdown only when there is more than one.",
            "items": {
              "type": "object",
              "required": ["version", "download_url"],
              "additionalProperties": true,
              "properties": {
                "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
                "download_url": { "type": "string", "format": "uri", "pattern": "^https://.*\\.zip$" },
                "size": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
